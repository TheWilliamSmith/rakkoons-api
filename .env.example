NODE_ENV=development
PORT=8080

POSTGRES_USER=rakkoons
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rakkoons
DATABASE_URL=postgresql://rakkoons:change-me@localhost:5432/rakkoons

HOST_UID=1000
HOST_GID=1000

CORS_ORIGIN=http://localhost:3000

JWT_ACCESS_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_TOKEN_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_ACCESS_TOKEN_EXPIRATION=15m
JWT_REFRESH_TOKEN_EXPIRATION=7d

COOKIE_SECURE=true
TERMS_VERSION=2026-01

SIGNUP_JOURNEY_TTL_MINUTES=15
SIGNUP_CODE_TTL_MINUTES=10
VERIFICATION_MAX_ATTEMPTS=5

SESSION_SLIDING_LIFETIME_DAYS=14
SESSION_ABSOLUTE_LIFETIME_DAYS=60

RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_USERNAME_AVAILABILITY=60
RATE_LIMIT_SIGN_UP=5
RATE_LIMIT_SIGN_UP_VERIFY=10
RATE_LIMIT_SIGN_IN_PER_IP=10
RATE_LIMIT_SIGN_IN_PER_ACCOUNT=5
